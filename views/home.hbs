<h1>Quản lý Sách</h1>
{{#if flash}}<p class="msg success">{{flash}}</p>{{/if}}
<p><small>Session (lưu trên MongoDB Atlas): <code>{{sessionId}}</code> — số lần xem: <b>{{views}}</b> — số sách bạn đã thêm trong phiên này: <b>{{addedCount}}</b></small></p>

<h2>Danh sách sách</h2>
<table>
  <tr><th>Mã SP</th><th>Tên sách</th><th>Giá gốc</th><th>VAT</th><th>Giá sau thuế</th></tr>
  {{#each books}}
  <tr><td>{{code}}</td><td>{{title}}</td><td>{{price}}</td><td>{{vatRate}}%</td><td>{{priceAfterVat}}</td></tr>
  {{else}}
  <tr><td colspan="5">Chưa có sách nào.</td></tr>
  {{/each}}
</table>

<h2>Thêm sách mới</h2>
{{#if error}}<p class="msg error">{{error}}</p>{{/if}}
<form method="POST" action="/books">
  <input name="code" placeholder="Mã SP (bắt đầu bằng {{CODE_PREFIX}}, vd {{CODE_PREFIX}}001)" required>
  <input name="title" placeholder="Tên sách" required>
  <input name="price" type="number" min="0" step="any" placeholder="Giá gốc (VNĐ)" required>
  <button type="submit">Thêm sách (tự tính VAT {{VAT_RATE}}%)</button>
</form>
